[Unit]
Description=Common Foundry mainnet rich list (unspent outputs by address, checked against the node)
After=network-online.target commonfoundry-mainnet-gateway.service
Wants=network-online.target

[Service]
Type=simple
User=cmfd-richlist
Group=cmfd-richlist
ExecStart=/usr/bin/python3 /opt/cmfd-richlist/cmfd-richlist.py --state /var/lib/cmfd-richlist/state --credentials /etc/cmfd-richlist/gateway.conf --url http://127.0.0.1:39102/ --output /var/lib/cmfd-richlist/public/richlist.json --fetch-threads 2 --interval 30
Restart=always
RestartSec=30
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/cmfd-richlist

[Install]
WantedBy=multi-user.target
