{
  "name": "@common-foundry/website",
  "private": true,
  "version": "0.1.0-devnet.16",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/build-agent-text.mjs && node scripts/build-discovery.mjs",
    "test:mcp": "node --test scripts/mcp.node.mjs",
    "test:webmcp": "node --test scripts/webmcp.node.mjs",
    "test:rental-auth": "node --test scripts/rental-auth-proxy.node.mjs",
    "verify:mcp": "node scripts/verify-mcp-live.mjs",
    "verify:skills": "node scripts/verify-skills-live.mjs",
    "test:discovery": "node --test scripts/agent-discovery.node.mjs",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  }
}
