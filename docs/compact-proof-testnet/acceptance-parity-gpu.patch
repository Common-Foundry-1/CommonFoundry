+// Hold one immutable 1.5 GiB witness and one separate 1.5 GiB standby slot.
+// A new replay closes the preceding witness; process exit closes all handles.
+// EVICT releases GPU weights but must not invalidate the pending handoff.
+class SealedReplayExports {
+    struct Slot { int fd = -1; void* mapping = MAP_FAILED; bool registered = false; };
+    static constexpr size_t BYTES = size_t{512} << 20;
+public:
+    ~SealedReplayExports() { clear(); }
+    void clear() {
+        for (auto& slot : slots_) {
+            if (slot.registered) cudaHostUnregister(slot.mapping);
+            if (slot.mapping != MAP_FAILED) ::munmap(slot.mapping, BYTES);
+            if (slot.fd >= 0) ::close(slot.fd);
+        }
+        slots_.clear(); published_ = 0;
+    }
+    void prepare(const std::string& path) {
+        if (slots_.size() == 3 && published_ == 0) return;
+        if (standby_.valid()) {
+            auto next = standby_.get();
+            clear();
+            slots_ = std::move(next->slots_);
+            return;
+        }
+        const auto parent = std::filesystem::path(path).parent_path();
+        struct stat permissions{}; struct statfs filesystem{};
+        if (::stat(parent.c_str(), &permissions) || ::statfs(parent.c_str(), &filesystem)
+            || permissions.st_uid != ::geteuid() || (permissions.st_mode & 0777) != 0700
+            || filesystem.f_type != TMPFS_MAGIC)
+            throw std::runtime_error("sealed replay export requires an owned private tmpfs directory");
+        // A new RUN is serialized after the previous prover finished opening
+        // the immutable descriptors. Bound resident handoff storage to 1.5 GiB.
+        clear();
+        const auto started = std::chrono::steady_clock::now();
+        try {
+            for (int bank = 0; bank < 3; ++bank) {
+                slots_.push_back(Slot{});
+                auto& slot = slots_.back();
+                slot.fd = static_cast<int>(::syscall(SYS_memfd_create,
+                    "cmfd-sealed-gpu-witness", MFD_CLOEXEC | MFD_ALLOW_SEALING));
+                if (slot.fd < 0 || ::ftruncate(slot.fd, BYTES))
+                    throw std::runtime_error("allocate bounded replay memfd");
+                slot.mapping = ::mmap(nullptr, BYTES, PROT_READ | PROT_WRITE,
+                    MAP_SHARED | MAP_POPULATE, slot.fd, 0);
+                if (slot.mapping == MAP_FAILED) throw std::runtime_error("populate replay memfd");
+                cuda_check(cudaHostRegister(slot.mapping, BYTES, cudaHostRegisterDefault),
+                    "register bounded replay destination");
+                slot.registered = true;
+            }
+        } catch (...) { clear(); throw; }
+        std::fprintf(stderr, "sealed_witness_prepare_seconds=%.6f bytes=%zu\n",
+            std::chrono::duration<double>(std::chrono::steady_clock::now()-started).count(), 3*BYTES);
+    }
+    void append(const std::string& path, const uint32_t* first,
+                const uint32_t* second, size_t values) {
+        if (2 * values * sizeof(uint32_t) != BYTES || slots_.size() != 3 || published_ >= 3)
+            throw std::runtime_error("sealed replay witness exceeds its bounded shape");
+        auto& slot = slots_[published_];
+        const auto started = std::chrono::steady_clock::now();
+        cuda_check(cudaMemcpy(slot.mapping, first, values * sizeof(uint32_t), cudaMemcpyDeviceToHost),
+                   "export first sealed witness half");
+        cuda_check(cudaMemcpy(static_cast<uint32_t*>(slot.mapping) + values, second,
+                              values * sizeof(uint32_t), cudaMemcpyDeviceToHost),
+                   "export second sealed witness half");
+        const double copy_seconds = std::chrono::duration<double>(std::chrono::steady_clock::now()-started).count();
+        cuda_check(cudaHostUnregister(slot.mapping), "unregister sealed witness destination");
+        slot.registered = false;
+        if (::munmap(slot.mapping, BYTES)) throw std::runtime_error("unmap sealed witness writer");
+        slot.mapping = MAP_FAILED;
+        constexpr int seals = F_SEAL_WRITE | F_SEAL_GROW | F_SEAL_SHRINK | F_SEAL_SEAL;
+        if (::fcntl(slot.fd, F_ADD_SEALS, seals) || (::fcntl(slot.fd, F_GET_SEALS) & seals) != seals)
+            throw std::runtime_error("seal replay witness before publishing");
+        const auto source = "/proc/" + std::to_string(::getpid()) + "/fd/" + std::to_string(slot.fd);
+        if (::symlink(source.c_str(), path.c_str()))
+            throw std::runtime_error("publish sealed replay descriptor");
+        ++published_;
+        if (published_ == 3) {
+            // Prepare a separate bounded witness slot while the current sealed
+            // witness is proved. Its fds/maps never alias published bytes.
+            // Two slots total at most 3 GiB of host RAM and add no device arrays.
+            standby_ = std::async(std::launch::async, [path] {
+                cuda_check(cudaSetDevice(0), "select standby witness context");
+                auto next = std::make_unique<SealedReplayExports>();
+                next->prepare(path);
+                return next;
+            });
+        }
+        std::fprintf(stderr, "sealed_witness_export bank=%zu copy_seconds=%.6f seal_and_release_seconds=%.6f\n",
+            published_-1, copy_seconds,
+            std::chrono::duration<double>(std::chrono::steady_clock::now()-started).count()-copy_seconds);
+    }
+private:
+    std::vector<Slot> slots_;
+    size_t published_ = 0;
+    std::future<std::unique_ptr<SealedReplayExports>> standby_;
+};
+
+bool sealed_witness_enabled() {
+    const char* setting = std::getenv("CMFD_REPLAY_SEALED_EXPORT");
+    return setting && std::strcmp(setting, "1") == 0;
+}
+SealedReplayExports& replay_exports() {
+    static thread_local SealedReplayExports exports;
+    return exports;
+}
