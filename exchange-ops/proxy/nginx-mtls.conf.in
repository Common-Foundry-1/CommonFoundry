# Optional remote boundary. The node itself remains on numeric loopback HTTP.
# Render and qualify this under the exchange's certificate and logging policy.
limit_conn_zone $binary_remote_addr zone=cmfd_exchange_clients:1m;

server {
    listen @@MTLS_LISTEN_ADDRESS@@:@@MTLS_PORT@@ ssl;
    server_name @@SERVER_NAME@@;

    ssl_protocols TLSv1.3;
    ssl_certificate @@SERVER_CERTIFICATE@@;
    ssl_certificate_key @@SERVER_PRIVATE_KEY@@;
    ssl_client_certificate @@CLIENT_CA_BUNDLE@@;
    ssl_verify_client on;
    ssl_verify_depth 2;
    ssl_session_tickets off;

    client_max_body_size 4m;
    limit_conn cmfd_exchange_clients 4;

    location = / {
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_pass http://127.0.0.1:@@EXCHANGE_RPC_PORT@@/;
    }

    location / {
        return 404;
    }
}
