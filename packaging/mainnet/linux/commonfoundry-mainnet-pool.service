[Unit]
Description=Common Foundry mainnet pool (staged; separate from RC)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=commonfoundry-mainnet-pool
Group=commonfoundry-mainnet-pool
SupplementaryGroups=video render
WorkingDirectory=/opt/commonfoundry-mainnet-pool/current
StateDirectory=commonfoundry-mainnet-pool
StateDirectoryMode=0700
RuntimeDirectory=commonfoundry-mainnet-pool
RuntimeDirectoryMode=0700
LoadCredential=wallet-passphrase:/etc/commonfoundry-mainnet-pool/wallet-passphrase
LoadCredential=pool-private-key:/etc/commonfoundry-mainnet-pool/pool-key.der
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/opt/commonfoundry-mainnet-pool/current/cmfd-node mainnet-launch-info
# The wallet requires a 0600 passphrase file. Privileged ("+") copies read the
# root-only /etc sources and leave service-owned 0600 files in the 0700 runtime
# directory; they vanish on stop. systemd 249 (Ubuntu 22.04) has no %d specifier
# and fills the credentials directory only for ExecStart=, so the copies cannot
# use it. LoadCredential= is kept on purpose to declare the same sources.
# A drop-in that changes User=/Group= or a source path must change these lines too.
ExecStartPre=+/usr/bin/install --mode=0600 --owner=commonfoundry-mainnet-pool --group=commonfoundry-mainnet-pool /etc/commonfoundry-mainnet-pool/wallet-passphrase /run/commonfoundry-mainnet-pool/wallet-passphrase
ExecStartPre=+/usr/bin/install --mode=0600 --owner=commonfoundry-mainnet-pool --group=commonfoundry-mainnet-pool /etc/commonfoundry-mainnet-pool/pool-key.der /run/commonfoundry-mainnet-pool/pool-private-key
ExecStart=/usr/bin/python3 /opt/commonfoundry-mainnet-pool/current/mainnet-pool-service.py --run /etc/commonfoundry-mainnet-pool/pool.json
KillSignal=SIGINT
TimeoutStartSec=infinity
TimeoutStopSec=240
Restart=on-failure
# Status 3: the node will not start this service while block admission is halted
# by the work rule; an operator acts first (see the instructions in the log).
# Status 4: a start refused for a reason a restart does not change.
RestartPreventExitStatus=3 4
RestartSec=30
UMask=0077
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectClock=true
# Install the host-specific NVIDIA DeviceAllow drop-in from POOL-SERVICE-SETUP.md.
# Keep device access closed except for those explicitly selected GPU devices.
DevicePolicy=closed
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/commonfoundry-mainnet-pool /opt/commonfoundry-mainnet-pool/current/production-mainnet
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=commonfoundry-mainnet-pool

[Install]
WantedBy=multi-user.target
