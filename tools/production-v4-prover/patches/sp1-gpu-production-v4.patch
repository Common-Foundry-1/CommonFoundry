+__global__ void tripleHadamardFixLastVariableAndSumAsPoly(
+    const ext_t* first_input,
+    const ext_t* second_input,
+    const ext_t* third_input,
+    ext_t* __restrict__ first_output,
+    ext_t* __restrict__ second_output,
+    ext_t* __restrict__ third_output,
+    ext_t alpha,
+    ext_t* univariate_result,
+    size_t inputHeight) {
+    size_t outputHeight = inputHeight >> 1;
+    ext_t evalZero = ext_t::zero();
+    ext_t evalTwo = ext_t::zero();
+    ext_t evalThree = ext_t::zero();
+    auto block = cg::this_thread_block();
+    auto pair = cg::tiled_partition<2>(block);
+
+    for (size_t i = blockDim.x * blockIdx.x + threadIdx.x; i < outputHeight;
+         i += blockDim.x * gridDim.x) {
+        size_t startingIdx = i << 1;
+        ext_t firstZero = ext_t::load(first_input, startingIdx);
+        ext_t firstOne = ext_t::load(first_input, startingIdx + 1);
+        ext_t secondZero = ext_t::load(second_input, startingIdx);
+        ext_t secondOne = ext_t::load(second_input, startingIdx + 1);
+        ext_t thirdZero = ext_t::load(third_input, startingIdx);
+        ext_t thirdOne = ext_t::load(third_input, startingIdx + 1);
+        ext_t firstValue = alpha * firstOne + (ext_t::one() - alpha) * firstZero;
+        ext_t secondValue = alpha * secondOne + (ext_t::one() - alpha) * secondZero;
+        ext_t thirdValue = alpha * thirdOne + (ext_t::one() - alpha) * thirdZero;
+        ext_t::store(first_output, i, firstValue);
+        ext_t::store(second_output, i, secondValue);
+        ext_t::store(third_output, i, thirdValue);
+
+        ext_t previousFirst = pair.shfl(firstValue, 0);
+        ext_t previousSecond = pair.shfl(secondValue, 0);
+        ext_t previousThird = pair.shfl(thirdValue, 0);
+        if ((pair.thread_rank() & 1) == 0) {
+            evalZero += firstValue * secondValue * thirdValue;
+        } else {
+            ext_t firstTwo = firstValue + firstValue - previousFirst;
+            ext_t secondTwo = secondValue + secondValue - previousSecond;
+            ext_t thirdTwo = thirdValue + thirdValue - previousThird;
+            ext_t firstThree = firstTwo + firstValue - previousFirst;
+            ext_t secondThree = secondTwo + secondValue - previousSecond;
+            ext_t thirdThree = thirdTwo + thirdValue - previousThird;
+            evalTwo += firstTwo * secondTwo * thirdTwo;
+            evalThree += firstThree * secondThree * thirdThree;
+        }
+    }
+
+    extern __shared__ unsigned char memory[];
+    ext_t* shared = reinterpret_cast<ext_t*>(memory);
+    auto reduceTile = cg::tiled_partition<32>(block);
+    ext_t zeroBlockSum = partialBlockReduce(block, reduceTile, evalZero, shared);
+    ext_t twoBlockSum = partialBlockReduce(block, reduceTile, evalTwo, shared);
+    ext_t threeBlockSum = partialBlockReduce(block, reduceTile, evalThree, shared);
+    if (threadIdx.x == 0) {
+        ext_t::store(univariate_result, blockIdx.x, zeroBlockSum);
+        ext_t::store(univariate_result, gridDim.x + blockIdx.x, twoBlockSum);
+        ext_t::store(univariate_result, 2 * gridDim.x + blockIdx.x, threeBlockSum);
+    }
+}
