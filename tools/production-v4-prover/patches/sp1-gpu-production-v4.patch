+__global__ void cubicTransitionSumAsPoly(
+    ext_t* __restrict__ result,
+    const ext_t* __restrict__ preactivation_mle,
+    const ext_t* __restrict__ next_activation_mle,
+    const ext_t* __restrict__ equality_mle,
+    size_t numVariablesMinusOne) {
+    size_t height = 1 << numVariablesMinusOne;
+    ext_t evalZero = ext_t::zero();
+    ext_t evalTwo = ext_t::zero();
+    ext_t evalThree = ext_t::zero();
+    ext_t evalFour = ext_t::zero();
+    for (size_t i = blockDim.x * blockIdx.x + threadIdx.x; i < height;
