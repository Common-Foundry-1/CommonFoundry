+        size_t evenIdx = i << 1;
+        size_t oddIdx = evenIdx + 1;
+        ext_t preZero = ext_t::load(preactivation_mle, evenIdx);
+        ext_t preOne = ext_t::load(preactivation_mle, oddIdx);
+        ext_t nextZero = ext_t::load(next_activation_mle, evenIdx);
+        ext_t nextOne = ext_t::load(next_activation_mle, oddIdx);
+        ext_t eqZero = ext_t::load(equality_mle, evenIdx);
+        ext_t eqOne = ext_t::load(equality_mle, oddIdx);
+        ext_t preStep = preOne - preZero;
+        ext_t nextStep = nextOne - nextZero;
+        ext_t eqStep = eqOne - eqZero;
+        ext_t preTwo = preOne + preStep;
+        ext_t nextTwo = nextOne + nextStep;
+        ext_t eqTwo = eqOne + eqStep;
+        ext_t preThree = preTwo + preStep;
+        ext_t nextThree = nextTwo + nextStep;
+        ext_t eqThree = eqTwo + eqStep;
+        ext_t preFour = preThree + preStep;
+        ext_t nextFour = nextThree + nextStep;
+        ext_t eqFour = eqThree + eqStep;
+        evalZero += cubicTransitionRelation(preZero, nextZero, eqZero);
+        evalTwo += cubicTransitionRelation(preTwo, nextTwo, eqTwo);
+        evalThree += cubicTransitionRelation(preThree, nextThree, eqThree);
+        evalFour += cubicTransitionRelation(preFour, nextFour, eqFour);
+    }
+
+    extern __shared__ unsigned char memory[];
+    ext_t* shared = reinterpret_cast<ext_t*>(memory);
+    auto block = cg::this_thread_block();
+    auto tile = cg::tiled_partition<32>(block);
+    ext_t zeroBlockSum = partialBlockReduce(block, tile, evalZero, shared);
+    ext_t twoBlockSum = partialBlockReduce(block, tile, evalTwo, shared);
+    ext_t threeBlockSum = partialBlockReduce(block, tile, evalThree, shared);
+    ext_t fourBlockSum = partialBlockReduce(block, tile, evalFour, shared);
+    if (threadIdx.x == 0) {
+        ext_t::store(result, blockIdx.x, zeroBlockSum);
+        ext_t::store(result, gridDim.x + blockIdx.x, twoBlockSum);
+        ext_t::store(result, 2 * gridDim.x + blockIdx.x, threeBlockSum);
+        ext_t::store(result, 3 * gridDim.x + blockIdx.x, fourBlockSum);
+    }
+}
+
+__global__ void cubicTransitionFixLastVariableAndSumAsPoly(
+    const ext_t* preactivation_input,
+    const ext_t* next_activation_input,
+    const ext_t* equality_input,
+    ext_t* __restrict__ preactivation_output,
+    ext_t* __restrict__ next_activation_output,
+    ext_t* __restrict__ equality_output,
+    ext_t alpha,
+    ext_t* univariate_result,
+    size_t inputHeight) {
+    size_t outputHeight = inputHeight >> 1;
+    ext_t evalZero = ext_t::zero();
+    ext_t evalTwo = ext_t::zero();
+    ext_t evalThree = ext_t::zero();
+    ext_t evalFour = ext_t::zero();
+    auto block = cg::this_thread_block();
+    auto pair = cg::tiled_partition<2>(block);
+
+    for (size_t i = blockDim.x * blockIdx.x + threadIdx.x; i < outputHeight;
+         i += blockDim.x * gridDim.x) {
+        size_t startingIdx = i << 1;
+        ext_t preZero = ext_t::load(preactivation_input, startingIdx);
+        ext_t preOne = ext_t::load(preactivation_input, startingIdx + 1);
+        ext_t nextZero = ext_t::load(next_activation_input, startingIdx);
+        ext_t nextOne = ext_t::load(next_activation_input, startingIdx + 1);
+        ext_t eqZero = ext_t::load(equality_input, startingIdx);
+        ext_t eqOne = ext_t::load(equality_input, startingIdx + 1);
+        ext_t preValue = alpha * preOne + (ext_t::one() - alpha) * preZero;
+        ext_t nextValue = alpha * nextOne + (ext_t::one() - alpha) * nextZero;
+        ext_t eqValue = alpha * eqOne + (ext_t::one() - alpha) * eqZero;
+        ext_t::store(preactivation_output, i, preValue);
+        ext_t::store(next_activation_output, i, nextValue);
+        ext_t::store(equality_output, i, eqValue);
+
+        ext_t previousPre = pair.shfl(preValue, 0);
+        ext_t previousNext = pair.shfl(nextValue, 0);
+        ext_t previousEq = pair.shfl(eqValue, 0);
+        if ((pair.thread_rank() & 1) == 0) {
+            evalZero += cubicTransitionRelation(preValue, nextValue, eqValue);
+        } else {
+            ext_t preStep = preValue - previousPre;
+            ext_t nextStep = nextValue - previousNext;
+            ext_t eqStep = eqValue - previousEq;
+            ext_t preTwo = preValue + preStep;
+            ext_t nextTwo = nextValue + nextStep;
+            ext_t eqTwo = eqValue + eqStep;
+            ext_t preThree = preTwo + preStep;
+            ext_t nextThree = nextTwo + nextStep;
+            ext_t eqThree = eqTwo + eqStep;
+            ext_t preFour = preThree + preStep;
+            ext_t nextFour = nextThree + nextStep;
+            ext_t eqFour = eqThree + eqStep;
+            evalTwo += cubicTransitionRelation(preTwo, nextTwo, eqTwo);
+            evalThree += cubicTransitionRelation(preThree, nextThree, eqThree);
+            evalFour += cubicTransitionRelation(preFour, nextFour, eqFour);
+        }
+    }
+
+    extern __shared__ unsigned char memory[];
+    ext_t* shared = reinterpret_cast<ext_t*>(memory);
+    auto reduceTile = cg::tiled_partition<32>(block);
+    ext_t zeroBlockSum = partialBlockReduce(block, reduceTile, evalZero, shared);
+    ext_t twoBlockSum = partialBlockReduce(block, reduceTile, evalTwo, shared);
+    ext_t threeBlockSum = partialBlockReduce(block, reduceTile, evalThree, shared);
+    ext_t fourBlockSum = partialBlockReduce(block, reduceTile, evalFour, shared);
+    if (threadIdx.x == 0) {
+        ext_t::store(univariate_result, blockIdx.x, zeroBlockSum);
+        ext_t::store(univariate_result, gridDim.x + blockIdx.x, twoBlockSum);
+        ext_t::store(univariate_result, 2 * gridDim.x + blockIdx.x, threeBlockSum);
+        ext_t::store(univariate_result, 3 * gridDim.x + blockIdx.x, fourBlockSum);
+    }
+}
+
+extern "C" void* cubic_transition_sum_as_poly_ext_kernel() {
+    return (void*)cubicTransitionSumAsPoly;
+}
+
+extern "C" void* cubic_transition_fix_last_variable_and_sum_as_poly_ext_kernel() {
+    return (void*)cubicTransitionFixLastVariableAndSumAsPoly;
+}
