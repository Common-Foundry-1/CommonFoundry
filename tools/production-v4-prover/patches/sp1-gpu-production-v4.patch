+fn observe_round_polynomial<C>(challenger: &mut C, polynomial: &UnivariatePolynomial<Ext>)
+where
+    C: FieldChallenger<Felt>,
+{
+    challenger.observe_slice(
+        &polynomial
+            .coefficients
+            .iter()
+            .flat_map(|value| value.as_base_slice())
+            .copied()
+            .collect_vec(),
+    );
+}
