+__global__ void cmfdFixedBankRlc(
+    const uint8_t* __restrict__ encoded,
+    const ext_t* __restrict__ coefficients,
+    ext_t* __restrict__ output,
+    size_t rows,
+    size_t columns) {
+    const size_t row = static_cast<size_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (row >= rows) {
+        return;
+    }
+    ext_t accumulator = ext_t::zero();
+    for (size_t column = 0; column < columns; ++column) {
+        const int centered = static_cast<int>(encoded[column * rows + row]) - 125;
+        const kb31_t value = centered >= 0
+                                 ? kb31_t::from_canonical_u32(static_cast<uint32_t>(centered))
+                                 : kb31_t::zero() - kb31_t::from_canonical_u32(
+                                                        static_cast<uint32_t>(-centered));
+        accumulator += ext_t::load(coefficients, column) * value;
+    }
+    ext_t::store(output, row, accumulator);
+}
+
+__global__ void cmfdFixedBankEvaluateColumns(
+    const uint8_t* __restrict__ encoded,
+    const ext_t* __restrict__ equality,
+    ext_t* __restrict__ output,
+    size_t rows) {
+    const size_t column = blockIdx.x;
+    ext_t accumulator = ext_t::zero();
+    const size_t base = column * rows;
+    for (size_t row = threadIdx.x; row < rows; row += blockDim.x) {
+        const int centered = static_cast<int>(encoded[base + row]) - 125;
+        const kb31_t value = centered >= 0
+                                 ? kb31_t::from_canonical_u32(static_cast<uint32_t>(centered))
+                                 : kb31_t::zero() - kb31_t::from_canonical_u32(
+                                                        static_cast<uint32_t>(-centered));
+        accumulator += ext_t::load(equality, row) * value;
+    }
+    __shared__ ext_t partials[256];
+    partials[threadIdx.x] = accumulator;
+    __syncthreads();
+    for (unsigned stride = blockDim.x / 2; stride != 0; stride >>= 1) {
+        if (threadIdx.x < stride) {
+            partials[threadIdx.x] += partials[threadIdx.x + stride];
+        }
+        __syncthreads();
+    }
+    if (threadIdx.x == 0) {
+        ext_t::store(output, column, partials[0]);
+    }
+}
