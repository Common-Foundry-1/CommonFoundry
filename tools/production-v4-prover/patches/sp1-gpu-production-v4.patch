+__global__ void tripleHadamardSumAsPoly(
+    ext_t* __restrict__ result,
+    const ext_t* __restrict__ first_mle,
+    const ext_t* __restrict__ second_mle,
+    const ext_t* __restrict__ third_mle,
+    size_t numVariablesMinusOne) {
+    size_t height = 1 << numVariablesMinusOne;
+    ext_t evalZero = ext_t::zero();
+    ext_t evalTwo = ext_t::zero();
+    ext_t evalThree = ext_t::zero();
+    for (size_t i = blockDim.x * blockIdx.x + threadIdx.x; i < height;
+         i += blockDim.x * gridDim.x) {
+        size_t evenIdx = i << 1;
+        size_t oddIdx = evenIdx + 1;
+        ext_t firstZero = ext_t::load(first_mle, evenIdx);
+        ext_t firstOne = ext_t::load(first_mle, oddIdx);
+        ext_t secondZero = ext_t::load(second_mle, evenIdx);
+        ext_t secondOne = ext_t::load(second_mle, oddIdx);
+        ext_t thirdZero = ext_t::load(third_mle, evenIdx);
+        ext_t thirdOne = ext_t::load(third_mle, oddIdx);
+        ext_t firstTwo = firstOne + firstOne - firstZero;
+        ext_t secondTwo = secondOne + secondOne - secondZero;
+        ext_t thirdTwo = thirdOne + thirdOne - thirdZero;
+        ext_t firstThree = firstTwo + firstOne - firstZero;
+        ext_t secondThree = secondTwo + secondOne - secondZero;
+        ext_t thirdThree = thirdTwo + thirdOne - thirdZero;
+        evalZero += firstZero * secondZero * thirdZero;
+        evalTwo += firstTwo * secondTwo * thirdTwo;
+        evalThree += firstThree * secondThree * thirdThree;
+    }
+
+    extern __shared__ unsigned char memory[];
+    ext_t* shared = reinterpret_cast<ext_t*>(memory);
+    auto block = cg::this_thread_block();
+    auto tile = cg::tiled_partition<32>(block);
+    ext_t zeroBlockSum = partialBlockReduce(block, tile, evalZero, shared);
+    ext_t twoBlockSum = partialBlockReduce(block, tile, evalTwo, shared);
+    ext_t threeBlockSum = partialBlockReduce(block, tile, evalThree, shared);
+    if (threadIdx.x == 0) {
+        ext_t::store(result, blockIdx.x, zeroBlockSum);
+        ext_t::store(result, gridDim.x + blockIdx.x, twoBlockSum);
+        ext_t::store(result, 2 * gridDim.x + blockIdx.x, threeBlockSum);
+    }
+}
